# Copia este archivo a .env y completa tus credenciales (no subas .env a GitHub)
SECRET_KEY=genera-una-clave-secreta-django
DEBUG=True
DB_NAME=multitenant_db
DB_USER=postgres
DB_PASSWORD=postgres
REDIS_URL=redis://127.0.0.1:6379/1
DJANGO_SETTINGS_MODULE=config.settings.development

# Mercado Pago — Panel de desarrolladores → Credenciales de prueba o producción
MERCADOPAGO_PUBLIC_KEY=APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MERCADOPAGO_ACCESS_TOKEN=APP_USR-xxxxxxxx-xxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxx-xxxxxxxxxx
MERCADOPAGO_WEBHOOK_URL=http://localhost:8000/api/v1/payments/webhook/

FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Comisiones MP Colombia (opcional)
MP_COMMISSION_RATE=0.0329
MP_IVA_RATE=0.19
MP_WITHDRAWAL_ALERT_DAYS=150
MP_WITHDRAWAL_MAX_DAYS=180
